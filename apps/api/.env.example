# SQLite by default. To switch to Postgres, change the datasource provider in
# prisma/schema.prisma to "postgresql" and point this at your Postgres URL.
DATABASE_URL="file:./dev.db"
PORT=3000
HOST=0.0.0.0
# Contact string sent as the User-Agent to OpenStreetMap services (required by their usage policy).
OSM_CONTACT="amble-dev (mathys.nourry@gmail.com)"
# Free OpenRouteService key (https://openrouteservice.org/dev/#/signup) — enables
# real street-following routes and turn-by-turn directions. Optional: leave blank
# and walks fall back to a stylized synthetic loop with no turn-by-turn.
ORS_API_KEY=""
