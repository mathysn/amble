{
  "name": "amble",
  "version": "0.1.0",
  "private": true,
  "description": "Amble — walks that go nowhere in particular. Full-stack monorepo.",
  "scripts": {
    "api": "pnpm --filter @amble/api dev",
    "mobile": "pnpm --filter @amble/mobile start",
    "build:shared": "pnpm --filter @amble/shared build",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.9.0"
}
